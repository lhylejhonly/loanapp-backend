DJANGO_ENV=production
DJANGO_SECRET_KEY=replace-with-a-strong-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=loan-app-backend.onrender.com,loanapp-backend-q0la.onrender.com,127.0.0.1,localhost

# CORS / CSRF
DJANGO_CORS_ALLOW_ALL_DEBUG=False
DJANGO_CORS_ALLOWED_ORIGINS=https://loan-app-backend.onrender.com,https://loanapp-backend-q0la.onrender.com,http://127.0.0.1:19006,http://localhost:19006,http://127.0.0.1:8081,http://localhost:8081,http://127.0.0.1:8000,http://localhost:8000
DJANGO_CSRF_TRUSTED_ORIGINS=https://loan-app-backend.onrender.com,https://loanapp-backend-q0la.onrender.com,http://127.0.0.1:8000,http://localhost:8000

# Cookies / proxy / security
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_CSRF_COOKIE_SAMESITE=Lax
DJANGO_SECURE_REFERRER_POLICY=same-origin
DJANGO_SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin
DJANGO_X_FRAME_OPTIONS=DENY
DJANGO_USE_X_FORWARDED_HOST=True

# JWT
DJANGO_ACCESS_TOKEN_HOURS=24
DJANGO_REFRESH_TOKEN_DAYS=7

# API / uploads / throttling
DJANGO_API_PAGE_SIZE=25
DJANGO_LOG_LEVEL=INFO
DJANGO_MAX_UPLOAD_MB=10
DJANGO_THROTTLE_ANON=60/minute
DJANGO_THROTTLE_USER=300/minute
DJANGO_THROTTLE_LOGIN=10/minute
DJANGO_THROTTLE_REGISTER=5/minute
DJANGO_THROTTLE_VERIFICATION_SEND=5/minute
DJANGO_THROTTLE_VERIFICATION_VERIFY=10/minute
DJANGO_THROTTLE_FORGOT_PASSWORD=5/minute
DJANGO_THROTTLE_RESET_PASSWORD=10/minute

# Email verification
# Use EMAIL_VERIFICATION_PROVIDER=console for local development.
# Use gmail, smtp, or resend in real deployments.
EMAIL_VERIFICATION_PROVIDER=console
EMAIL_VERIFICATION_CODE_LENGTH=6
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_SENDS_PER_HOUR=5
EMAIL_VERIFICATION_MAX_VERIFY_ATTEMPTS=5
EMAIL_VERIFICATION_LOCKOUT_MINUTES=15
EMAIL_VERIFICATION_SUBJECT=Your ElevateFunds verification code

# SMTP / Gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_TIMEOUT=15

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMS verification
SMS_PROVIDER=disabled
SMS_DEFAULT_COUNTRY_CODE=+63
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Database (PostgreSQL only)
# Render can provide DATABASE_URL instead of the individual DJANGO_DB_* values.
DJANGO_DB_NAME=loan_app
DJANGO_DB_USER=postgres
DJANGO_DB_PASSWORD=postgres
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5433
DJANGO_DB_CONNECT_TIMEOUT=5

# Media storage
# Use filesystem for local development. Switch to s3 for production object storage.
DJANGO_MEDIA_STORAGE=filesystem
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=False

# Provider-backed loan disbursements
DISBURSEMENT_PROVIDER=manual
XENDIT_API_URL=https://api.xendit.co
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_GCASH_CHANNEL_CODE=PH_GCASH
