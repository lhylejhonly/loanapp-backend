# Local development
# Use auto so the app follows the current Expo/dev host.
EXPO_PUBLIC_API_URL=auto
EXPO_PUBLIC_API_PORT=8000
EXPO_PUBLIC_API_PATH=/api

# Optional local override if Expo host detection needs help.
# EXPO_PUBLIC_DEV_SERVER_HOST=192.168.1.50

# Production example
# Set EXPO_PUBLIC_API_URL to your deployed HTTPS API base URL, for example:
# EXPO_PUBLIC_API_URL=https://api.example.com/api
