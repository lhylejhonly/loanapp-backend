{
  "expo": {
    "name": "ElevateFunds",
    "slug": "elevatefunds",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3A8A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.elevatefunds.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "monochromeImage": "./assets/images/logo.png",
        "backgroundColor": "#1E3A8A"
      },
      "package": "com.elevatefunds.app",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow ElevateFunds to use your camera to capture your ID documents."
        }
      ],
      "./plugins/withAndroidCleartextTraffic"
    ],
    "extra": {
      "eas": {
        "projectId": "c2697ff4-bf98-47dc-b6fa-c976e3eb410c"
      }
    },
    "owner": "pelayo13"
  }
}
